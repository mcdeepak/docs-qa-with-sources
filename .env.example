# Copy to .env to change any of these. Every value has a working default.
APP_PORT=8000
APP_USERNAME=admin
APP_PASSWORD=admin
SECRET_KEY=local-development-only

# Swappable parts.
RETRIEVER=bm25          # bm25
ANSWERER=extractive     # extractive | llm

# Minimum share of the question a passage must cover to count as support (0 to 1).
SUPPORT_THRESHOLD=0.55
# How heavily a question word that appears in no document counts against a passage.
ABSENT_TERM_WEIGHT=2.0
USE_SYNONYMS=true

# Worker. A crashed worker's job is picked up again after the lease runs out.
WORKER_LEASE_SECONDS=20
# Slows each indexing stage. Only for demonstrating live status and crash recovery.
INDEX_DELAY_SECONDS=0

# Optional model-written answers (ANSWERER=llm). Any OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
